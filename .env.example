TD_HOST=your-teradata-hostname-or-ip
TD_USER=your-readonly-user
TD_PASSWORD=your-password
TD_DATABASE=your-default-database   # optional

# Generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
API_KEY=your-secret-api-key

# Only needed for HTTP mode (node server.js --http)
HTTP_PORT=3000
JWT_SECRET=your-jwt-secret
